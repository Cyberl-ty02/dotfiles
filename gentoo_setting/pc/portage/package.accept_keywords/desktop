# CUDA core archives + existing Flatpak SDK, not host glibc/compiler.
dev-util/cuda-sdk-flatpak::gentoo-zh ~amd64
dev-util/pixi ~amd64

# LLVM 的 libgcc ABI shim，避免安装原生 GCC。
llvm-runtimes/libgcc ~amd64
media-fonts/harmonyos-sans::gentoo-zh ~amd64
media-fonts/nerdfonts ~amd64
media-gfx/krita ~amd64
net-im/telegram-desktop ~amd64
net-proxy/flclash-bin::gentoo-zh ~amd64
net-wireless/iwd ~amd64

# GNU 用户态替代工具先并行安装；不覆盖系统核心命令。
sys-apps/toybox ~amd64
sys-apps/uutils-coreutils ~amd64
sys-apps/uutils-findutils ~amd64

# Exact GSP firmware data for the accepted open NVIDIA modules.
sys-firmware/nvidia-gsp-firmware::gentoo-zh ~amd64
sys-kernel/gentoo-kernel-modprep ~amd64
sys-kernel/xanmod-kernel::gentoo-zh ~amd64
sys-libs/gcompat ~amd64
sys-libs/kpmcore ~amd64
sys-libs/libucontext ~amd64
sys-libs/musl-cxx-runtime ~amd64

# Private NVIDIA musl loader/core user-space experiment.
sys-libs/nvidia-musl-compat::gentoo-zh ~amd64
virtual/dist-kernel::gentoo-zh ~amd64

# Exact open modules for the accepted musl kernel; no user-space driver.
x11-drivers/nvidia-drivers::gentoo ~amd64
x11-drivers/nvidia-userspace-musl::gentoo-zh ~amd64
x11-misc/nvidia-modprobe ~amd64
