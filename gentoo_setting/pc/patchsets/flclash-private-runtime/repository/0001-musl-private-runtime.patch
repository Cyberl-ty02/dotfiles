+#!/usr/bin/python3
+"""Restore the caller's native environment before launching a desktop helper."""
+import json
+import os
+from pathlib import Path
+import sys
+
+name = Path(sys.argv[0]).name
+allowed = {'gio', 'gsettings', 'kde-open5', 'kde-open6', 'kioclient5', 'kioclient6',
+           'pkexec', 'xdg-email', 'xdg-mime', 'xdg-open', 'xmessage'}
+if name not in allowed:
+    raise SystemExit('Unknown FlClash native helper')
+env = dict(os.environ)
+original = json.loads(env.pop('FLCLASH_NATIVE_ENV', '{}'))
+for key, value in original.items():
+    if value is None:
+        env.pop(key, None)
+    else:
+        env[key] = value
+env['PATH'] = env.get('PATH', '/usr/bin:/bin').replace('/usr/libexec/flclash-native-helpers:', '')
+os.execvpe(name, [name, *sys.argv[1:]], env)
