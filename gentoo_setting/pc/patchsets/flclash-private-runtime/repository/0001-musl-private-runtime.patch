+#!/usr/bin/python3
+"""Private glibc frontend; native Core and host desktop helpers remain separate."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import subprocess
+import sys
+
+APP = Path('/opt/FlClash')
+BASE = Path('/var/lib/flatpak/runtime')
+FDO = BASE / 'org.freedesktop.Platform/x86_64/26.08/active/files'
+GL = BASE / 'org.freedesktop.Platform.GL.default/x86_64/26.08/active/files'
+JDK = Path('/opt/dragonwell-glibc-21')
+FIELDS = ('PATH', 'JAVA_HOME', 'LD_LIBRARY_PATH', 'LD_PRELOAD', 'GTK_IM_MODULE',
+          'XMODIFIERS', 'GSETTINGS_SCHEMA_DIR', 'GIO_MODULE_DIR', 'GIO_EXTRA_MODULES',
+          'LIBGL_ALWAYS_SOFTWARE', 'LIBGL_DRIVERS_PATH', 'XDG_DATA_DIRS',
+          'LOCPATH', '__EGL_VENDOR_LIBRARY_FILENAMES')
+
+
+def prepare():
+    loader = FDO / 'lib/x86_64-linux-gnu/ld-linux-x86-64.so.2'
+    if not loader.is_file() or not (GL / 'lib/dri').is_dir():
+        raise RuntimeError('先安装系统级 Freedesktop Platform 26.08 及匹配的 GL.default 扩展')
+    release = (JDK / 'release').read_text()
+    if ('LIBC="gnu"' not in release or 'Alibaba Dragonwell Standard Edition' not in release
+            or 'JAVA_VERSION="21.' not in release):
+        raise RuntimeError('需要 dragonwell-bin:21[glibc-runtime] 的私有 Standard 21')
+    native_release = Path('/etc/java-config-2/current-system-vm/release').read_text()
+    for field in ('JAVA_VERSION', 'IMPLEMENTOR_VERSION'):
+        private = next(x for x in release.splitlines() if x.startswith(field + '='))
+        if private not in native_release.splitlines():
+            raise RuntimeError('宿主与私有 Dragonwell Standard 21 版本不一致，请先复核升级')
+    for relative, expected in json.loads((APP / 'compat/immutable-sha256.json').read_text()).items():
+        with (APP / relative).open('rb') as stream:
+            if hashlib.file_digest(stream, 'sha256').hexdigest() != expected:
+                raise RuntimeError('受保护的 AOT/Core 已改变：' + relative)
+    env = dict(os.environ)
+    env['FLCLASH_NATIVE_ENV'] = json.dumps({key: env.get(key) for key in FIELDS})
+    env.pop('LD_LIBRARY_PATH', None)
+    env.pop('LD_PRELOAD', None)
+    env.update(JAVA_HOME=str(JDK), GTK_IM_MODULE='xim',
+               GSETTINGS_SCHEMA_DIR=str(FDO / 'share/glib-2.0/schemas'),
+               GIO_MODULE_DIR=str(FDO / 'lib/x86_64-linux-gnu/gio/modules'),
+               GIO_EXTRA_MODULES='', LIBGL_DRIVERS_PATH=str(GL / 'lib/dri'),
+               XDG_DATA_DIRS=f'{FDO}/share:/usr/local/share:/usr/share',
+               LOCPATH=str(BASE / 'org.freedesktop.Platform.Locale/x86_64/26.08/active/files/zh/lib'),
+               __EGL_VENDOR_LIBRARY_FILENAMES=str(GL / 'share/glvnd/egl_vendor.d/50_mesa.json'))
+    env.setdefault('XMODIFIERS', '@im=fcitx')
+    # Software rendering is local to this small frontend; never change host GL.
+    env.setdefault('LIBGL_ALWAYS_SOFTWARE', '1')
+    env['PATH'] = '/usr/libexec/flclash-native-helpers:' + os.environ.get('PATH', '/usr/bin:/bin')
+    libraries = ':'.join(map(str, [APP / 'lib', APP / 'compat/tray', JDK / 'lib/server',
+                                   FDO / 'lib/x86_64-linux-gnu', FDO / 'lib', GL / 'lib']))
+    return loader, libraries, env
+
+
+def main():
+    loader, libraries, env = prepare()
+    if sys.argv[1:] == ['--check-runtime']:
+        files = [APP / 'FlClash', APP / 'FlClashHelperService']
+        files += [p for p in sorted((APP / 'lib').glob('*.so')) if p.name != 'libapp.so']
+        files += [p for p in sorted((APP / 'compat/tray').iterdir()) if not p.is_symlink()]
+        for path in files:
+            result = subprocess.run([str(loader), '--library-path', libraries, '--list', str(path)],
+                                    env=env, capture_output=True, text=True)
+            if result.returncode or 'not found' in result.stdout:
+                raise RuntimeError(f'{path.name}: {result.stdout}\n{result.stderr}')
+        print(json.dumps(dict(runtime='26.08', java='Dragonwell Standard 21',
+                              elf_dependencies_checked=len(files), native_vm_changed=False)))
+        return
+    if os.geteuid() == 0:
+        raise RuntimeError('请以普通桌面用户启动 FlClash')
+    os.execve(str(APP / 'FlClash'), [str(APP / 'FlClash'), *sys.argv[1:]], env)
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (OSError, RuntimeError, ValueError, StopIteration) as error:
+        raise SystemExit('FlClash 私有运行时检查失败：' + str(error))
