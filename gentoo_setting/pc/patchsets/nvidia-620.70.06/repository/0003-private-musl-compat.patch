--- /dev/null
+++ b/sys-libs/nvidia-musl-compat/files/091-nvidia-ldso-tls-prealloc.patch
@@ -0,0 +1,208 @@
+The NVIDIA driver uses initial-exec TLS in its glcore, which
+normally prevents such library from dlopening, as initial-exec
+uses fixed offsets from the thread pointer. On glibc, the ldso
+allocates extra space ahead of time for such purposes (allowing
+usage of initial-exec up until it runs out). Take the same
+strategy here and alloc some extra bytes to allow a late static
+TLS allocation.
+
+-- q66
+
+diff --git a/ldso/dynlink.c b/ldso/dynlink.c
+index 65c3117..78f464c 100644
+--- a/ldso/dynlink.c
++++ b/ldso/dynlink.c
+@@ -31,6 +31,9 @@ static size_t ldso_page_size;
+ #undef PAGE_SIZE
+ #define PAGE_SIZE ldso_page_size
+ #endif
++#ifdef LIBC_NVIDIA_BUILD
++#define STATIC_TLS_PREALLOC 256
++#endif
+ 
+ #define malloc __libc_malloc
+ #define calloc __libc_calloc
+@@ -90,6 +93,7 @@ struct dso {
+ 	char mark;
+ 	char bfs_built;
+ 	char runtime_loaded;
++	char dynamic_tls;
+ 	struct dso **deps, *needed_by;
+ 	size_t ndeps_direct;
+ 	size_t next_dep;
+@@ -147,7 +151,9 @@ static pthread_rwlock_t lock;
+ static struct debug debug;
+ static struct tls_module *tls_tail;
+ static size_t tls_cnt, tls_offset, tls_align = MIN_TLS_ALIGN;
+-static size_t static_tls_cnt;
++#ifdef LIBC_NVIDIA_BUILD
++static size_t static_tls_offset, initial_tls_offset;
++#endif
+ static pthread_mutex_t init_fini_lock;
+ static pthread_cond_t ctor_cond;
+ static struct dso *builtin_deps[2];
+@@ -487,7 +493,7 @@ static void do_relocs(struct dso *dso, size_t *rel, size_t rel_size, size_t stri
+ 		tls_val = def.sym ? def.sym->st_value : 0;
+ 
+ 		if ((type == REL_TPOFF || type == REL_TPOFF_NEG)
+-		    && def.dso->tls_id > static_tls_cnt) {
++		    && def.dso->dynamic_tls) {
+ 			error("Error relocating %s: %s: initial-exec TLS "
+ 				"resolves to dynamic definition in %s",
+ 				dso->name, name, def.dso->name);
+@@ -556,7 +562,7 @@ static void do_relocs(struct dso *dso, size_t *rel, size_t rel_size, size_t stri
+ #endif
+ 		case REL_TLSDESC:
+ 			if (stride<3) addend = reloc_addr[!TLSDESC_BACKWARDS];
+-			if (def.dso->tls_id > static_tls_cnt) {
++			if (def.dso->dynamic_tls) {
+ 				struct td_index *new = malloc(sizeof *new);
+ 				if (!new) {
+ 					error(
+@@ -1107,8 +1113,12 @@ static struct dso *load_library(const char *name, struct dso *needed_by)
+ 	int fd;
+ 	struct stat st;
+ 	size_t alloc_size;
++#ifdef LIBC_NVIDIA_BUILD
++	size_t static_tls_noff;
++#endif
+ 	int n_th = 0;
+ 	int is_self = 0;
++	int dynamic_tls = 0;
+ 
+ 	if (!*name) {
+ 		errno = EINVAL;
+@@ -1252,8 +1262,36 @@ static struct dso *load_library(const char *name, struct dso *needed_by)
+ 	 * the newly-loaded DSO. */
+ 	alloc_size = sizeof *p + strlen(pathname) + 1;
+ 	if (runtime && temp_dso.tls.image) {
++#ifdef LIBC_NVIDIA_BUILD
++		size_t dyn[DYN_CNT], per_th = sizeof(void *) * (tls_cnt+3);
++		decode_vec(temp_dso.dynv, dyn, DYN_CNT);
++		if (dyn[DT_FLAGS] & DF_STATIC_TLS) {
++			/* calculate if we have enough space in the static block,
++			 * and also only accept ponter-aligned tls so that the
++			 * loaded dsos can't affect how much space we can use
++			 */
++			static_tls_noff = static_tls_offset;
++#ifdef TLS_ABOVE_TP
++			static_tls_noff += (temp_dso.tls.align-1) & (-static_tls_offset + (uintptr_t)temp_dso.tls.image);
++			static_tls_noff += temp_dso.tls.size;
++#else
++			static_tls_noff += temp_dso.tls.size + temp_dso.tls.align - 1;
++			static_tls_noff -= (static_tls_noff + (uintptr_t)temp_dso.tls.image) & (temp_dso.tls.align-1);
++#endif
++			if (temp_dso.tls.align > MIN_TLS_ALIGN)
++				dynamic_tls = 1;
++			else if ((static_tls_noff - initial_tls_offset) > STATIC_TLS_PREALLOC)
++				dynamic_tls = 1;
++		} else
++			dynamic_tls = 1;
++		/* dynamic tls space for this dso per thread */
++		if (dynamic_tls)
++			per_th += temp_dso.tls.size + temp_dso.tls.align;
++#else
+ 		size_t per_th = temp_dso.tls.size + temp_dso.tls.align
+ 			+ sizeof(void *) * (tls_cnt+3);
++		dynamic_tls = 1;
++#endif
+ 		n_th = libc.threads_minus_1 + 1;
+ 		if (n_th > SSIZE_MAX / per_th) alloc_size = SIZE_MAX;
+ 		else alloc_size += n_th * per_th;
+@@ -1269,22 +1307,49 @@ static struct dso *load_library(const char *name, struct dso *needed_by)
+ 	p->needed_by = needed_by;
+ 	p->name = p->buf;
+ 	p->runtime_loaded = runtime;
++	p->dynamic_tls = dynamic_tls;
+ 	strcpy(p->name, pathname);
+ 	/* Add a shortname only if name arg was not an explicit pathname. */
+ 	if (pathname != name) p->shortname = strrchr(p->name, '/')+1;
+ 	if (p->tls.image) {
++		size_t dynamic_off = 0;
+ 		p->tls_id = ++tls_cnt;
++		/* the offset calculation is important to preserve regardless
++		 * of if the tls will be dynamic, because when new threads are
++		 * created, continuous space is allocated for all tls up until
++		 * that point; it will use those offsets for that memory
++		 */
+ 		tls_align = MAXP2(tls_align, p->tls.align);
++#ifdef LIBC_NVIDIA_BUILD
++		/* for the first dyntls, move it past the preallocated block
++		 * to avoid using that space, save it for actual static tls
++		 */
++		if (dynamic_tls && tls_offset == static_tls_offset)
++			dynamic_off = STATIC_TLS_PREALLOC;
++#endif
+ #ifdef TLS_ABOVE_TP
+-		p->tls.offset = tls_offset + ( (p->tls.align-1) &
++		p->tls.offset = tls_offset + dynamic_off + ( (p->tls.align-1) &
+ 			(-tls_offset + (uintptr_t)p->tls.image) );
+ 		tls_offset = p->tls.offset + p->tls.size;
+ #else
+-		tls_offset += p->tls.size + p->tls.align - 1;
++		tls_offset += dynamic_off + p->tls.size + p->tls.align - 1;
+ 		tls_offset -= (tls_offset + (uintptr_t)p->tls.image)
+ 			& (p->tls.align-1);
+ 		p->tls.offset = tls_offset;
+ #endif
++#ifdef LIBC_NVIDIA_BUILD
++		/* but if the tls is not dynamic while being dlopened,
++		 * we need a separate static offset so we use the memory
++		 * block that we preallocated
++		 */
++		if (!dynamic_tls && runtime) {
++			p->tls.offset = static_tls_offset = static_tls_noff;
++#ifdef TLS_ABOVE_TP
++			p->tls.offset -= p->tls.size;
++#endif
++		}
++		/* new_dtv is always used, new_tls may not be */
++#endif /* LIBC_NVIDIA_BUILD */
+ 		p->new_dtv = (void *)(-sizeof(size_t) &
+ 			(uintptr_t)(p->name+strlen(p->name)+sizeof(size_t)));
+ 		p->new_tls = (void *)(p->new_dtv + n_th*(tls_cnt+1));
+@@ -1687,6 +1752,9 @@ static void update_tls_size()
+ 	libc.tls_size = ALIGN(
+ 		(1+tls_cnt) * sizeof(void *) +
+ 		tls_offset +
++#ifdef LIBC_NVIDIA_BUILD
++		((tls_offset == static_tls_offset) ? STATIC_TLS_PREALLOC : 0) +
++#endif
+ 		sizeof(struct pthread) +
+ 		tls_align * 2,
+ 	tls_align);
+@@ -1713,6 +1781,23 @@ static void install_new_tls(void)
+ 	/* Install new dtls into the enlarged, uninstalled dtv copies. */
+ 	for (p=head; ; p=p->next) {
+ 		if (p->tls_id <= old_cnt) continue;
++#ifdef LIBC_NVIDIA_BUILD
++		if (!p->dynamic_tls) {
++			/* install static tls into each thread */
++			for (j=0, td=self; !j || td!=self; j++, td=td->next) {
++				unsigned char *new = (unsigned char *)td;
++#ifdef TLS_ABOVE_TP
++				new += sizeof(struct pthread) + p->tls.offset;
++#else
++				new -= p->tls.offset;
++#endif
++				memcpy(new, p->tls.image, p->tls.len);
++				newdtv[j][p->tls_id] = (uintptr_t)new + DTP_OFFSET;
++			}
++			if (p->tls_id == tls_cnt) break;
++			continue;
++		}
++#endif
+ 		unsigned char *mem = p->new_tls;
+ 		for (j=0; j<i; j++) {
+ 			unsigned char *new = mem;
+@@ -2067,7 +2152,9 @@ void __dls3(size_t *sp, size_t *auxv)
+ 			_exit(127);
+ 		}
+ 	}
+-	static_tls_cnt = tls_cnt;
++#ifdef LIBC_NVIDIA_BUILD
++	static_tls_offset = initial_tls_offset = tls_offset;
++#endif
+ 
+ 	/* The main program must be relocated LAST since it may contain
+ 	 * copy relocations which depend on libraries' relocations. */
