+ cd "${WORKDIR}/musl-build" || die
+ CC="$(tc-getCC)" CFLAGS="${CFLAGS} -DLIBC_NVIDIA_BUILD" "${S}/configure" --prefix=/usr/libexec/nvidia-musl --syslibdir=/usr/libexec/nvidia-musl --disable-static --disable-gcc-wrapper || die
