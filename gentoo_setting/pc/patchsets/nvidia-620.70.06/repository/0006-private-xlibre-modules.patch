--- /dev/null
+++ b/x11-drivers/nvidia-userspace-musl/files/nvidia-musl-xorg
@@ -0,0 +1,10 @@
+#!/bin/sh
+# 仅选择已安装的私有 NVIDIA 模块；不更改登录器、VT 或系统 Xorg 配置。
+set -eu
+xorg=/usr/bin/Xorg
+module_path=$("${xorg}" -showDefaultModulePath 2>&1)
+case "${module_path}" in
+    /*) ;;
+    *) echo 'Cannot determine the XLibre module path.' >&2; exit 1 ;;
+esac
+exec /usr/bin/nvidia-musl-run "${xorg}" -modulepath "/usr/libexec/nvidia-musl/xorg,${module_path}" "$@"
