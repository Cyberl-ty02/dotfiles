@@ -0,0 +1,38 @@
+# Copyright 2026 Gentoo Authors
+# Distributed under the terms of the GNU General Public License v2
+EAPI=8
+inherit unpacker
+DESCRIPTION="Private patched NVIDIA userspace libraries for a dedicated musl launcher"
+HOMEPAGE="https://github.com/chimera-linux/cports/pull/6531"
+SRC_URI="https://download.nvidia.com/XFree86/Linux-x86_64/${PV}/NVIDIA-Linux-x86_64-${PV}.run"
+S="${WORKDIR}"
+LICENSE="NVIDIA-2025 BSD-2"
+SLOT="0/${PV%%.*}"
+KEYWORDS="~amd64"
+RESTRICT="bindist mirror strip"
+RDEPEND="=sys-libs/nvidia-musl-compat-1.2.6_p20261115 media-libs/libglvnd x11-libs/libX11 x11-libs/libXext >=dev-lang/python-3.11 =x11-drivers/nvidia-drivers-${PV}[modules-only]"
+BDEPEND=">=dev-util/patchelf-0.18 app-arch/tar app-arch/xz-utils app-arch/zstd"
+src_configure() { :; }
+src_compile() { :; }
+src_install() {
+ local name src soname
+ local -a candidates
+ exeinto /usr/libexec/nvidia-musl/driver
+ for name in libEGL_nvidia libGLESv1_CM_nvidia libGLESv2_nvidia libGLX_nvidia libnvidia-allocator libnvidia-eglcore libnvidia-glsi libnvidia-glcore libnvidia-gpucomp libnvidia-tls libnvidia-ml libcuda; do
+  mapfile -t candidates < <(find "${S}" -type f -name "${name}.so.${PV}" -not -path '*/32/*')
+  [[ ${#candidates[@]} == 1 ]] || die "Expected one amd64 ${name}"
+  src=${candidates[0]}
+  patchelf --remove-needed ld-linux-x86-64.so.2 --remove-needed libdl.so.2 --remove-needed libm.so.6 --remove-needed libpthread.so.0 --remove-needed librt.so.1 --replace-needed libc.so.6 libc.so --add-needed libnvcompat.so.0 --rename-dynamic-symbols "${FILESDIR}/libnvcompat.map" "${src}" || die
+  doexe "${src}"
+  soname=$(patchelf --print-soname "${src}") || die
+  [[ -z ${soname} || ${soname} == "${src##*/}" ]] || dosym "${src##*/}" "/usr/libexec/nvidia-musl/driver/${soname}"
+ done
+ insinto /usr/libexec/nvidia-musl
+ newins "${FILESDIR}/egl-vendor.json" egl-vendor.json
+ dobin "${FILESDIR}/nvidia-musl-run"
+ dodoc "${FILESDIR}/CHIMERA-COPYING"
+}
+pkg_postinst() {
+ elog "Dedicated private driver prefix only, not a complete XLibre/session integration."
+ elog "No global EGL/Vulkan registration, service start, module load or stock musl change."
+}
