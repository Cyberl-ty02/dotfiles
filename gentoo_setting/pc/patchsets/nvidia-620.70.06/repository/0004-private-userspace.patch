+#!/usr/bin/python3
+"""Run one musl ELF under the private NVIDIA loader, without global libc changes."""
+import os, shutil, struct, sys
+from pathlib import Path
+PREFIX=Path('/usr/libexec/nvidia-musl')
+def main():
+ if len(sys.argv)<2 or sys.argv[1]=='--help':
+  print('Usage: nvidia-musl-run MUSL_ELF [ARGS...]; scripts, glibc ELF, complete sessions and child processes require separate validation.')
+  return
+ name=shutil.which(sys.argv[1])
+ if not name:raise SystemExit('Executable not found: '+sys.argv[1])
+ target=Path(name).resolve()
+ with target.open('rb') as f:
+  header=f.read(64)
+  if header[:6]!=b'\x7fELF\x02\x01' or struct.unpack_from('<H',header,18)[0]!=62:raise SystemExit('Expected x86-64 little-endian musl ELF; scripts are not accepted.')
+  phoff=struct.unpack_from('<Q',header,32)[0];phentsize,phnum=struct.unpack_from('<HH',header,54);interpreter=None
+  for n in range(phnum):
+   f.seek(phoff+n*phentsize);ph=f.read(phentsize)
+   if struct.unpack_from('<I',ph,0)[0]==3:
+    offset=struct.unpack_from('<Q',ph,8)[0];size=struct.unpack_from('<Q',ph,32)[0]
+    f.seek(offset);interpreter=f.read(size).rstrip(b'\0').decode();break
+ if not interpreter or 'ld-musl-x86_64.so.1' not in interpreter:raise SystemExit('Expected dynamic musl ELF; use cuda-sdk for its glibc programs.')
+ loader=PREFIX/'libc.so';paths=':'.join([str(PREFIX/'compat'),str(PREFIX/'driver'),'/usr/lib','/usr/lib/llvm/22/lib'])
+ env=dict(os.environ,__NV_PRIME_RENDER_OFFLOAD='1',__GLX_VENDOR_LIBRARY_NAME='nvidia',__EGL_VENDOR_LIBRARY_FILENAMES=str(PREFIX/'egl-vendor.json'))
+ env.pop('LD_PRELOAD',None);env.pop('LD_LIBRARY_PATH',None)
+ os.execve(str(loader),[str(loader),'--library-path',paths,'--preload',str(PREFIX/'compat/libgcompat.so.0'),str(target),*sys.argv[2:]],env)
+if __name__=='__main__':main()
