Subject: [PATCH] libipset: describe only available exports for strict LLD

The five removed names have no exported definition in ipset 7.24.
ipset_shift_argv is static; ipset_debug_msg is built only in debug mode.
Keep the latter optional without disabling version-script validation globally.
Local patch, not yet submitted upstream.

--- a/lib/libipset.map
+++ b/lib/libipset.map
@@ -46,7 +46,6 @@
   ipset_parse_ipnet;
   ipset_parse_ip4_single6;
   ipset_parse_ip4_net6;
-  ipset_parse_name;
   ipset_parse_before;
   ipset_parse_after;
   ipset_parse_setname;
@@ -84,8 +83,6 @@
   ipset_session_lineno;
   ipset_session_report;
   ipset_session_report_reset;
-  ipset_session_error;
-  ipset_session_warning;
   ipset_envopt_parse;
   ipset_envopt_test;
   ipset_session_output;
@@ -93,7 +90,7 @@
   ipset_cmd;
   ipset_session_init;
   ipset_session_fini;
-  ipset_debug_msg;
+  ipset_debug_msg*;
   ipset_cache_add;
   ipset_cache_del;
   ipset_cache_rename;
@@ -109,7 +106,6 @@
   ipset_match_cmd;
   ipset_match_option;
   ipset_match_envopt;
-  ipset_shift_argv;
 
 local: *;
 };
@@ -124,7 +120,6 @@
 
 LIBIPSET_3.0 {
 global:
-  ipset_session_outfn;
 } LIBIPSET_2.0;
 
 LIBIPSET_4.0 {
