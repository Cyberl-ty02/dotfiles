+#!/usr/bin/python3
+"""Run versioned CUDA core tools in the existing managed Flatpak SDK."""
+import fcntl, hashlib, json, os, shutil, subprocess, sys, tempfile
+from pathlib import Path
+
+VERSION = "13.4.1"
+DATA = Path("/usr/share/cuda-sdk-flatpak") / VERSION
+
+def main():
+    if sys.argv[1:] == ["--help"]:
+        print("Usage: cuda-sdk [COMMAND [ARGS...]]; default: bash. Examples: cuda-sdk nvcc --version; cuda-sdk ./program")
+        print("Uses the managed glibc SDK. Set CUDA_SDK_NETWORK=1 only when network access is needed.")
+        return
+    if os.geteuid() == 0:
+        raise SystemExit("Run cuda-sdk as your desktop user; install its package/runtime as root in chroot.")
+    config_bytes = (DATA / "components.json").read_bytes()
+    config = json.loads(config_bytes)
+    runtime = config["runtime"]
+    if subprocess.run(["flatpak", "info", "--system", runtime], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
+        raise SystemExit("Missing system SDK: flatpak install --system flathub org.freedesktop.Sdk//26.08")
+    cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "cuda-sdk-flatpak" / VERSION
+    cache.mkdir(mode=0o700, parents=True, exist_ok=True)
+    fingerprint = hashlib.sha256(config_bytes).hexdigest()
+    toolkit = cache / "toolkit"
+    with (cache / "prepare.lock").open("a+") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        marker = toolkit / ".source-manifest.sha256"
+        ready = marker.is_file() and marker.read_text().strip() == fingerprint and (toolkit / "bin/nvcc").is_file()
+        if not ready:
+            if shutil.disk_usage(cache).free < 1024**3:
+                raise SystemExit("CUDA tool cache needs at least 1GiB free for safe preparation.")
+            temp = Path(tempfile.mkdtemp(prefix=".prepare-", dir=cache))
+            try:
+                for component in config["components"]:
+                    archive = DATA / "archives" / component["name"]
+                    digest = hashlib.sha256()
+                    with archive.open("rb") as stream:
+                        for block in iter(lambda: stream.read(4 * 1024**2), b""):
+                            digest.update(block)
+                    if digest.hexdigest() != component["sha256"]:
+                        raise RuntimeError("CUDA archive hash mismatch: " + component["name"])
+                    members = [component["root"] + "/" + name for name in component["members"]]
+                    subprocess.run(["tar", "-xf", str(archive), "-C", str(temp), "--strip-components=1", "--no-same-owner", *members], check=True)
+                (temp / "lib64").symlink_to("lib")
+                (temp / "version.txt").write_text("CUDA Version " + VERSION + "\n")
+                (temp / ".source-manifest.sha256").write_text(fingerprint + "\n")
+                if toolkit.exists():
+                    shutil.rmtree(toolkit)
+                temp.rename(toolkit)
+            finally:
+                if temp.exists():
+                    shutil.rmtree(temp)
+        build = cache / "flatpak"
+        (build / "files").mkdir(parents=True, exist_ok=True)
+        (build / "metadata").write_text("[Application]\nname=local.gentoo.CudaSdk\nruntime=" + runtime + "\nsdk=" + runtime + "\n")
+    cwd = str(Path.cwd())
+    network = "--share=network" if os.environ.get("CUDA_SDK_NETWORK") == "1" else "--unshare=network"
+    command = sys.argv[1:] or ["/bin/bash"]
+    args = ["flatpak", "build", "--runtime", "--readonly", "--die-with-parent", network,
+            "--device=dri", "--nofilesystem=host", "--filesystem=" + cwd,
+            "--filesystem=" + str(cache), "--filesystem=" + str(toolkit) + ":ro",
+            "--env=CUDA_HOME=" + str(toolkit), "--env=CUDA_WORKDIR=" + cwd,
+            "--env=LANG=" + os.environ.get("LANG", "C.UTF-8"),
+            "--env=LC_ALL=" + os.environ.get("LC_ALL", ""),
+            str(build), "/bin/sh", "-c",
+            'export PATH="$CUDA_HOME/bin:$PATH"; export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; cd "$CUDA_WORKDIR" || exit; exec "$@"',
+            "cuda-sdk", *command]
+    for key in ("LC_MESSAGES", "LC_CTYPE", "LC_TIME", "LC_NUMERIC", "LC_COLLATE", "TZ"):
+        if key in os.environ:
+            args.insert(args.index(str(build)), "--env=" + key + "=" + os.environ[key])
+    os.execvp(args[0], args)
+
+if __name__ == "__main__":
+    main()
