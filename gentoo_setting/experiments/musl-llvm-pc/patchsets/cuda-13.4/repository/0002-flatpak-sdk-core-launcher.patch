+# Copyright 2026 Gentoo Authors
+# Distributed under the terms of the GNU General Public License v2
+EAPI=8
+DESCRIPTION="Versioned CUDA NVCC/core-runtime archives and managed Flatpak SDK launcher"
+HOMEPAGE="https://developer.nvidia.com/cuda-toolkit https://docs.flatpak.org/"
+SRC_URI="
+	https://developer.download.nvidia.com/compute/cuda/redist/cccl/linux-x86_64/cccl-linux-x86_64-13.3.4.2.1-archive.tar.xz
+	https://developer.download.nvidia.com/compute/cuda/redist/cuda_crt/linux-x86_64/cuda_crt-linux-x86_64-13.4.59-archive.tar.xz
+	https://developer.download.nvidia.com/compute/cuda/redist/cuda_cudart/linux-x86_64/cuda_cudart-linux-x86_64-13.4.49-archive.tar.xz
+	https://developer.download.nvidia.com/compute/cuda/redist/cuda_nvcc/linux-x86_64/cuda_nvcc-linux-x86_64-13.4.59-archive.tar.xz
+	https://developer.download.nvidia.com/compute/cuda/redist/libnvvm/linux-x86_64/libnvvm-linux-x86_64-13.4.59-archive.tar.xz
+	https://developer.download.nvidia.com/compute/cuda/redist/libcurand/linux-x86_64/libcurand-linux-x86_64-10.4.4.49-archive.tar.xz
+"
+S="${WORKDIR}/${P}"
+LICENSE="NVIDIA-CUDA Apache-2.0-with-LLVM-exceptions BSD GPL-2"
+SLOT="13.4"
+KEYWORDS="~amd64"
+RESTRICT="bindist mirror"
+RDEPEND=">=sys-apps/flatpak-1.18 >=dev-lang/python-3.11 app-arch/tar app-arch/xz-utils"
+BDEPEND="app-arch/tar app-arch/xz-utils"
+
+src_unpack() {
+	mkdir -p "${S}" || die
+	local archive root
+	for archive in ${A}; do
+		root=${archive%.tar.xz}
+		tar -xOf "${DISTDIR}/${archive}" "${root}/LICENSE" > "${S}/${root}.LICENSE" || die
+	done
+}
+src_prepare() { default; }
+src_configure() { :; }
+src_compile() { :; }
+src_install() {
+	insinto "/usr/share/${PN}/${PV}"
+	newins "${FILESDIR}/components-${PV}.json" components.json
+	insinto "/usr/share/${PN}/${PV}/archives"
+	local archive
+	for archive in ${A}; do doins "${DISTDIR}/${archive}"; done
+	dobin "${FILESDIR}/cuda-sdk"
+	dodoc *.LICENSE
+}
+pkg_postinst() {
+	elog "Install org.freedesktop.Sdk//26.08 and matching NVIDIA GL extension with Flatpak --system."
+	elog "As your user: cuda-sdk nvcc --version; cuda-sdk nvcc ...; cuda-sdk ./program"
+	elog "This is a glibc SDK environment, not native musl output. No host GCC/glibc dependency."
+	elog "Only NVCC/core cudart and device headers/libdevice are provided, not all CUDA math libraries."
+}
