--- /dev/null
+++ b/dev-util/cuda-clang-device-headers/cuda-clang-device-headers-13.4.1.ebuild
@@ -0,0 +1,85 @@
+# Copyright 2026 Gentoo Authors
+# Distributed under the terms of the GNU General Public License v2
+
+EAPI=8
+
+DESCRIPTION="CUDA 13.4 headers, CCCL and libdevice for Clang device-only PTX emission"
+HOMEPAGE="https://developer.nvidia.com/cuda-toolkit https://llvm.org/docs/CompileCudaWithLLVM.html"
+SRC_URI="
+	https://developer.download.nvidia.com/compute/cuda/redist/cccl/linux-x86_64/cccl-linux-x86_64-13.3.4.2.1-archive.tar.xz
+	https://developer.download.nvidia.com/compute/cuda/redist/cuda_crt/linux-x86_64/cuda_crt-linux-x86_64-13.4.59-archive.tar.xz
+	https://developer.download.nvidia.com/compute/cuda/redist/cuda_cudart/linux-x86_64/cuda_cudart-linux-x86_64-13.4.49-archive.tar.xz
+	https://developer.download.nvidia.com/compute/cuda/redist/libnvvm/linux-x86_64/libnvvm-linux-x86_64-13.4.59-archive.tar.xz
+	https://developer.download.nvidia.com/compute/cuda/redist/libcurand/linux-x86_64/libcurand-linux-x86_64-10.4.4.49-archive.tar.xz
+"
+S="${WORKDIR}/${P}"
+
+LICENSE="NVIDIA-CUDA Apache-2.0-with-LLVM-exceptions BSD"
+SLOT="13.4"
+KEYWORDS="~amd64"
+RESTRICT="bindist mirror"
+
+# Data/headers only: deliberately no nvcc/ptxas/fatbinary/nvlink or libcudart.
+RDEPEND=">=llvm-core/clang-22.1.8:22[llvm_targets_NVPTX]"
+BDEPEND="app-arch/tar app-arch/xz-utils"
+
+CUDA_COMPONENT_ROOTS=(
+	cccl-linux-x86_64-13.3.4.2.1-archive
+	cuda_crt-linux-x86_64-13.4.59-archive
+	cuda_cudart-linux-x86_64-13.4.49-archive
+	libnvvm-linux-x86_64-13.4.59-archive
+	libcurand-linux-x86_64-10.4.4.49-archive
+)
+CUDA_DEVICE_PATH="/opt/cuda-clang-device-headers-${PV}"
+
+src_unpack() {
+	mkdir -p "${S}/component-licenses" || die
+	local root
+	for root in "${CUDA_COMPONENT_ROOTS[@]}"; do
+		case "${root}" in
+			libcurand-*)
+				# Clang22 runtime wrapper unconditionally includes this legacy header.
+				# Only its three-header closure is supplied, not the cuRAND library.
+				tar -xf "${DISTDIR}/${root}.tar.xz" -C "${S}" --strip-components=1 \
+					"${root}/include/curand_mtgp32_kernel.h" \
+					"${root}/include/curand_mtgp32.h" "${root}/include/curand.h" || die
+				;;
+			libnvvm-*)
+				tar -xf "${DISTDIR}/${root}.tar.xz" -C "${S}" --strip-components=1 \
+					"${root}/nvvm/libdevice" || die
+				;;
+			*)
+				tar -xf "${DISTDIR}/${root}.tar.xz" -C "${S}" --strip-components=1 \
+					"${root}/include" || die
+				;;
+		esac
+		tar -xOf "${DISTDIR}/${root}.tar.xz" "${root}/LICENSE" \
+			> "${S}/component-licenses/${root}.LICENSE" || die
+	done
+	printf 'CUDA Version %s\n' "${PV}" > "${S}/version.txt" || die
+}
+
+src_prepare() {
+	# This zero-context patch is restricted to one verified vendor CRT header.
+	echo "57d44776b0944872de79986ba133315ceac1873ba5a63516ec3ebbba7c5afc96  include/crt/math_functions.hpp" | sha256sum -c - || die
+	eapply --fuzz=0 "${FILESDIR}/cuda-13.4.59-musl-host-math.patch"
+	eapply_user
+}
+
+src_configure() { :; }
+src_compile() { :; }
+
+src_install() {
+	insinto "${CUDA_DEVICE_PATH}"
+	doins -r include nvvm version.txt
+	# Clang CUDA installation discovery expects the conventional directory layout.
+	# These remain empty; no glibc tools or CUDA host runtime are provided.
+	keepdir "${CUDA_DEVICE_PATH}/bin" "${CUDA_DEVICE_PATH}/lib64"
+	dodoc component-licenses/*
+}
+
+pkg_postinst() {
+	elog "Clang device-only data installed to ${CUDA_DEVICE_PATH}"
+	elog "Use --cuda-path=${CUDA_DEVICE_PATH} --cuda-device-only -S."
+	elog "No CUDA host linking/runtime, ptxas, nvcc, NVIDIA driver, or complete SDK is provided."
+}
