Subject: [PATCH] bun-bin: native amd64 musl archive and scoped runtime wrapper

Base: gentoo-zh 73b502777b071c0cb934f4ad0053eec6c54a2139

--- a/dev-lang/bun-bin/bun-bin-1.4.4.ebuild
+++ b/dev-lang/bun-bin/bun-bin-1.4.4.ebuild
@@ -3,12 +3,15 @@
 
 EAPI=8
 
-inherit shell-completion
+inherit shell-completion wrapper
 
 DESCRIPTION="Incredibly fast JavaScript runtime, bundler, test runner, and package manager"
 HOMEPAGE="https://bun.sh https://github.com/oven-sh/bun"
 SRC_URI="
-	amd64? ( https://github.com/oven-sh/bun/releases/download/bun-v${PV}/bun-linux-x64.zip -> ${P}-amd64.zip )
+	amd64? (
+ elibc_musl? ( https://github.com/oven-sh/bun/releases/download/bun-v${PV}/bun-linux-x64-musl-baseline.zip -> ${P}-amd64-musl-baseline.zip )
+ !elibc_musl? ( https://github.com/oven-sh/bun/releases/download/bun-v${PV}/bun-linux-x64.zip -> ${P}-amd64.zip )
+)
 	arm64? ( https://github.com/oven-sh/bun/releases/download/bun-v${PV}/bun-linux-aarch64.zip -> ${P}-arm64.zip )
 "
 S="${WORKDIR}"
@@ -19,26 +22,38 @@
 
 IUSE="symlink"
 
-BDEPEND="app-arch/unzip"
+BDEPEND="app-arch/unzip elibc_musl? ( sys-libs/musl-cxx-runtime dev-util/patchelf )"
 RDEPEND="
+	elibc_musl? ( sys-libs/musl-cxx-runtime )
 	symlink? ( !net-libs/nodejs )
 "
 
 RESTRICT="strip"
 
-QA_PREBUILT="usr/bin/bun"
+QA_PREBUILT="usr/bin/bun opt/bun-musl/bun"
 
 src_prepare() {
+	local -x LD_LIBRARY_PATH=${LD_LIBRARY_PATH-}
+	use elibc_musl && LD_LIBRARY_PATH="${ESYSROOT}/opt/musl-cxx-runtime/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
 	default
 	mv bun-linux*/bun . || die "Failed to move bun binary"
+	if use elibc_musl; then
+		patchelf --replace-needed libc.musl-x86_64.so.1 libc.so bun || die
+	fi
 	# generate shell completion scripts
 	for sh in bash fish zsh; do
-		env SHELL=${sh} "${S}/bun" completions ${sh} > "${WORKDIR}/completion.${sh}"
+		PATH=. SHELL=${sh} "${S}/bun" completions ${sh} > "${WORKDIR}/completion.${sh}" || die "Failed to generate ${sh} completion"
 	done
 }
 
 src_install() {
-	dobin bun
+	if use elibc_musl; then
+		exeinto /opt/bun-musl
+		doexe bun
+		make_wrapper bun /opt/bun-musl/bun "" /opt/musl-cxx-runtime/lib
+	else
+		dobin bun
+	fi
 	dosym bun /usr/bin/bunx
 	use symlink && dosym bun /usr/bin/node # fix env: node: No such file or directory
 
