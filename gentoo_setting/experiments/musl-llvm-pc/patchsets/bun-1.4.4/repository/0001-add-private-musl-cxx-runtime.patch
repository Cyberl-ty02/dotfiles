--- /dev/null
+++ b/sys-libs/musl-cxx-runtime/musl-cxx-runtime-15.2.0-r5.ebuild
@@ -0,0 +1,39 @@
+# Local migration package; private musl C++ runtime, without a GCC compiler.
+EAPI=8
+PYTHON_COMPAT=( python3_{12..14} )
+inherit python-any-r1
+DESCRIPTION="Private musl C++ runtime for vendor binaries without a GCC compiler"
+HOMEPAGE="https://pkgs.alpinelinux.org/package/v3.24/main/x86_64/libstdc++"
+SRC_URI="
+ https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/libstdc++-${PVR}.apk
+ https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/apk-tools-static-3.0.9-r0.apk
+ https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/alpine-keys-2.6-r0.apk
+"
+S="${WORKDIR}"
+LICENSE="GPL-3+ gcc-runtime-library-exception-3.1"
+SLOT="0"
+KEYWORDS="~amd64"
+RESTRICT="strip test"
+BDEPEND="${PYTHON_DEPS} dev-util/patchelf"
+RDEPEND="sys-libs/musl llvm-runtimes/libgcc"
+QA_PREBUILT="opt/musl-cxx-runtime/lib/libstdc++.so.6"
+pkg_pretend() {
+ [[ ${ARCH} == amd64 && ${ELIBC} == musl && -z ${EPREFIX} ]] || die "Only native amd64 musl is validated"
+}
+pkg_setup() { python-any-r1_pkg_setup; }
+src_unpack() {
+ "${PYTHON}" "${FILESDIR}/extract-verify.py" "${DISTDIR}" "${WORKDIR}" "${PVR}" || die
+}
+src_prepare() {
+ default
+ # Alpine and Gentoo use different libc/libgcc SONAMEs on musl.
+ local gcc_soname
+ gcc_soname=$(patchelf --print-soname "${ESYSROOT}/usr/lib/libgcc_s.so.1") || die
+ [[ ${gcc_soname} == libgcc_s.so.* && ${gcc_soname} != */* ]] || die "Unexpected LLVM ABI SONAME"
+ patchelf --replace-needed libc.musl-x86_64.so.1 libc.so "${WORKDIR}/libstdc++.so.6" || die
+ patchelf --replace-needed libgcc_s.so.1 "${gcc_soname}" "${WORKDIR}/libstdc++.so.6" || die
+}
+src_install() {
+ insinto /opt/musl-cxx-runtime/lib
+ doins "${WORKDIR}/libstdc++.so.6"
+}
