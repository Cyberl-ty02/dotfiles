+DIST apk-tools-static-3.0.9-r0.apk 2225910 BLAKE2B af9628475b3ea271c32277fe9e9fe96085555fa155cfef12fb73161772091a04ac72dc4a62cafa5777309810d327844473022264f4fb697e3fba6c900453ebd3 SHA512 c97f27bef2940bb6c23323bf9fe0f3c60932a3c676f1cea23d5f5664ee8be27f349bb0c905f5f3e1fe0b04cfd79d6e422829c49b12cacbce21b02d9b2d1fa083
+DIST alpine-keys-2.6-r0.apk 12200 BLAKE2B 1c24c5bc8ba2e191d8be75ddc1c086d7653314ae83f594f42b7514142cf001e582cbcbcc909779a493e3e47ee43ea94924ed01ea03f846757deff8a0d853594b SHA512 3b8eb03711995bbbc8fde964c694f783fbefaca5575ee26b4223389c6137e6fea33f0f2f9a84cc8a043257e95376eb4d0e47a28633e0ff73eb0cd524df21263a
--- /dev/null
+++ b/sys-libs/musl-cxx-runtime/files/extract-verify.py
@@ -0,0 +1,20 @@
+from pathlib import Path
+import gzip,io,tarfile,subprocess,sys
+dist,work=map(Path,sys.argv[1:3]);version=sys.argv[3]
+def files(name):
+ data=gzip.decompress((dist/name).read_bytes())
+ with tarfile.open(fileobj=io.BytesIO(data),mode='r:',ignore_zeros=True) as archive:
+  for member in archive:
+   if member.isfile():yield member.name,archive.extractfile(member).read()
+tool=work/'apk.static'
+for name,data in files('apk-tools-static-3.0.9-r0.apk'):
+ if Path(name).name=='apk.static':tool.write_bytes(data);tool.chmod(0o755)
+keys=work/'public-keys';keys.mkdir(exist_ok=True)
+for name,data in files('alpine-keys-2.6-r0.apk'):
+ if name.endswith('.pub'):(keys/Path(name).name).write_bytes(data)
+assert tool.is_file() and list(keys.glob('*.pub'))
+subprocess.run([str(tool),'--keys-dir',str(keys),'verify',str(dist/('libstdc++-'+version+'.apk'))],check=True)
+for name,data in files('libstdc++-'+version+'.apk'):
+ if name.startswith('usr/lib/libstdc++.so.6.'):
+  assert data.startswith(b'\x7fELF');(work/'libstdc++.so.6').write_bytes(data);break
+else:raise SystemExit('Expected runtime library absent')
