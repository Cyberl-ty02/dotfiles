From cc78c6923a35f169b96260f3c156177d8c4b7526
Subject: [PATCH] configure: backport oconfigure 2.1.1 musl naming fix
Upstream: https://github.com/kristapsdz/lowdown/commit/cc78c6923a35f169b96260f3c156177d8c4b7526
Bug: https://github.com/kristapsdz/lowdown/issues/186

--- a/configure
+++ b/configure
@@ -17,7 +17,7 @@
 
 # Which version of oconfigure is this?
 # shellcheck disable=SC2034
-OCONFIGURE_VERSION="2.1.0"
+OCONFIGURE_VERSION="2.1.1"
 
 # Number of parallel processes used for configuring.  If set to less
 # than or including zero, the maximum number of processes on the host is
@@ -2625,25 +2625,23 @@ __HEREDOC__
 fi
 
 cat << __HEREDOC__
-#if HAVE_SYS_CDEFS_H
-# include <sys/cdefs.h>
-#endif
-
-#ifndef __dead
-# define __dead __attribute__((__noreturn__))
-#endif /* !__dead */
-
-#ifndef __pure
-# define __pure __attribute__((__pure__))
-#endif /* !__pure */
-
-#ifndef __unused
-# define __unused __attribute__((__unused__))
-#endif /* !__unused */
-
-#ifndef __used
-# define __used __attribute__((__used__))
-#endif /* !__used */
+#if ENABLE_BSD_CDEFS
+# if HAVE_SYS_CDEFS_H
+#  include <sys/cdefs.h>
+# endif
+# ifndef __dead
+#  define __dead __attribute__((__noreturn__))
+# endif /* !__dead */
+# ifndef __pure
+#  define __pure __attribute__((__pure__))
+# endif /* !__pure */
+# ifndef __unused
+#  define __unused __attribute__((__unused__))
+# endif /* !__unused */
+# ifndef __used
+#  define __used __attribute__((__used__))
+# endif /* !__used */
+#endif /* ENABLE_BSD_CDEFS */
 __HEREDOC__
 
 if [ "$HAVE_CRYPT_NEWHASH" -eq 0 ]

