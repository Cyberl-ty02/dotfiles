# XLibre/X11 target. Fcitx 5.1.21 expects a legacy Wayland CMake finder
# absent from the selected SonicDE ECM. Other Wayland client libraries remain.
=app-i18n/fcitx-5.1.21:5 -wayland

# Yakuake uses Sonic Terminal/Konsole on X11; its optional KWayland backend
# requires ECM Wayland helpers removed by the selected SonicDE provider.
=kde-apps/yakuake-26.04.3:6 -wayland

# Fcitx dlopens Rime -> LevelDB. tcmalloc initial-exec TLS fails on stock musl.
# Verified by typing nihao<space> into a native Qt6 window and receiving 你好.
dev-libs/leveldb -tcmalloc

# The meta flag selects the volume UI. PipeWire supplies the sound server.
sonicde-base/sonicde-meta pulseaudio
media-video/pipewire sound-server flatpak
