{
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features",
        "editor.formatOnSave": true
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features",
        "editor.formatOnSave": true
    },
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.formatOnSave": true
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
        "editor.formatOnSave": true
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
        "editor.formatOnSave": true
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        },
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "[scss]": {
        "editor.defaultFormatter": "vscode.css-language-features",
        "editor.formatOnSave": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
        "editor.formatOnSave": true
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
        "editor.formatOnSave": true
    },
    "[typst]": {
        "editor.defaultFormatter": "myriad-dreamin.tinymist",
        "editor.formatOnSave": true
    },
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed"
    ],
    "cmake.configureOnOpen": false,
    "cmake.exportCompileCommandsFile": true,
    "cmake.ignoreCMakeListsMissing": true,
    "code-runner.clearPreviousOutput": true,
    "code-runner.enableAppInsights": false,
    "code-runner.executorMap": {
        "javascript": "bun run",
        "powershell": "powershell.exe -NoLogo -File",
        "python": "$pythonPath -u",
        "shellscript": "bash",
        "typescript": "bun run"
    },
    "code-runner.fileDirectoryAsCwd": true,
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.fontLigatures": false,
    "editor.fontFamily": "'IntoneMono NFM', Consolas, 'HarmonyOS Sans', monospace",
    "editor.inlineSuggest.enabled": true,
    "editor.minimap.maxColumn": 80,
    "editor.rulers": [88, 120],
    "editor.suggest.localityBonus": true,
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "extensions.autoCheckUpdates": true,
    "extensions.autoUpdate": true,
    "files.autoGuessEncoding": true,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.pixi/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true,
        "**/target/**": true
    },
    "git.autofetch": true,
    "git.confirmSync": true,
    "git.openRepositoryInParentFolders": "never",
    "git.pruneOnFetch": true,
    "javascript.preferences.importModuleSpecifier": "shortest",
    "javascript.suggest.autoImports": true,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "json.schemaDownload.trustedDomains": {
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com/": true
    },
    "notebook.lineNumbers": "on",
    "npm.packageManager": "bun",
    "npm.autoDetect": "on",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.typeCheckingMode": "basic",
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "redhat.telemetry.enabled": false,
    "rust-analyzer.check.command": "clippy",
    "search.exclude": {
        "**/.pixi/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true,
        "**/target/**": true
    },
    "security.workspace.trust.enabled": true,
    "task.allowAutomaticTasks": "off",
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.confirmOnExit": "hasChildProcesses",
    "terminal.integrated.defaultProfile.windows": "Windows PowerShell (VSCodium)",
    "terminal.integrated.fontFamily": "'IntoneMono NFM', Consolas, 'HarmonyOS Sans', monospace",
    "terminal.integrated.profiles.windows": {
        "Windows PowerShell (VSCodium)": {
            "args": ["-NoLogo"],
            "path": "powershell.exe"
        }
    },
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.suggest.enabled": true,
    "tinymist.exportPdf": "onSave",
    "tinymist.formatterMode": "typstyle",
    "tinymist.formatterPrintWidth": 100,
    "tinymist.lint.enabled": true,
    "typescript.preferences.importModuleSpecifier": "shortest",
    "typescript.preferences.preferTypeOnlyAutoImports": true,
    "typescript.suggest.autoImports": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "update.mode": "default",
    "window.title": "${dirty}${activeEditorLong}${separator}${rootName}${separator}${appName}",
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "workbench.editorAssociations": {
        "*.docx": "cweijan.officeViewer",
        "*.epub": "cweijan.officeViewer",
        "*.md": "cweijan.markdownViewer",
        "*.ods": "cweijan.officeViewer",
        "*.pdf": "cweijan.officeViewer",
        "*.pptx": "cweijan.officeViewer",
        "*.xls": "cweijan.officeViewer",
        "*.xlsm": "cweijan.officeViewer",
        "*.xlsx": "cweijan.officeViewer"
    },
    "workbench.iconTheme": "material-icon-theme",
    "workbench.startupEditor": "none"
}
