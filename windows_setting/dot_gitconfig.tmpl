[user]
	name = {{ .gitName | quote }}
	email = {{ .gitEmail | quote }}
[core]
	autocrlf = input
	editor = doom-editor.cmd
[init]
	defaultBranch = main
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[diff]
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[credential]
	helper = manager
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[include]
	path = ~/.gitconfig.local
