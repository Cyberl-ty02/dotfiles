# Shared Git Bash profile. Interactive-only features are guarded so scripts
# can source this file safely.
if [[ $- == *i* ]] && command -v oh-my-posh >/dev/null 2>&1; then
    theme="${POSH_THEME:-$HOME/scoop/apps/oh-my-posh/current/themes/paradox.omp.json}"
    if [[ -f "$theme" ]]; then
        eval "$(oh-my-posh init bash --config "$theme")"
    fi
    unset theme
fi

proxy() {
    local host="${PROXY_HOST:-127.0.0.1}"
    local http_port="${PROXY_HTTP_PORT:-7890}"
    local socks_port="${PROXY_SOCKS_PORT:-$http_port}"
    export HTTP_PROXY="http://${host}:${http_port}"
    export HTTPS_PROXY="$HTTP_PROXY"
    export ALL_PROXY="socks5h://${host}:${socks_port}"
    export NO_PROXY="localhost,127.0.0.1,::1"
    export http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY"
    export all_proxy="$ALL_PROXY" no_proxy="$NO_PROXY"
    printf 'Proxy enabled: HTTP %s; SOCKS %s\n' "$HTTP_PROXY" "$ALL_PROXY"
}

nproxy() {
    unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
    unset http_proxy https_proxy all_proxy no_proxy
    echo "Proxy disabled"
}

alias ll='ls -lh'
alias la='ls -lah'
alias l='ls -CF'

dotfiles_bin="$HOME/.local/bin"
if [[ -d $dotfiles_bin && :$PATH: != *":$dotfiles_bin:"* ]]; then
    export PATH="$dotfiles_bin:$PATH"
fi
unset dotfiles_bin

if command -v doom-editor.cmd >/dev/null 2>&1; then
    export EDITOR=doom-editor.cmd VISUAL=doom-editor.cmd GIT_EDITOR=doom-editor.cmd
    doom() { doom.cmd "$@"; }
    emacs() {
        if [[ $1 == -nw || $1 == --no-window-system ]]; then
            shift
            doom-editor.cmd "$@"
        else
            doom.cmd emacs -- "$@"
        fi
    }
    alias e=doom-emacs.cmd
    alias vi=doom-editor.cmd
    alias vim=doom-editor.cmd
fi
