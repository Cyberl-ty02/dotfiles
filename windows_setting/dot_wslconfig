[wsl2]
# Mirrored networking reuses the Windows network, DNS, firewall, and proxy.
networkingMode=Mirrored
dnsTunneling=true
firewall=true
autoProxy=true

# A custom kernel is deliberately machine-local. Uncomment paths only after
# verifying that the kernel and module VHD versions match.
# kernel=C:\\path\\to\\bzImage
# kernelModules=C:\\path\\to\\modules.vhdx
